<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SÀLT+ AETERNA OS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&family=Inter:wght@400;600&display=swap" rel="stylesheet">
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #000000;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            font-family: 'Inter', sans-serif;
            overflow: hidden;
        }

        /* Card Container Utama */
        .card {
            background-color: #050505;
            width: 380px;
            padding: 40px 30px;
            border-radius: 28px;
            border: 2px solid #00e5ff;
            box-shadow: 0 0 25px rgba(0, 229, 255, 0.25);
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* Branding SÀLT+ */
        .brand-salt {
            font-family: 'Inter', sans-serif;
            font-size: 38px;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: 6px;
            margin-bottom: 5px;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.6);
        }

        /* Sub-branding AETERNA OS */
        .brand-aeterna {
            font-family: 'Orbitron', sans-serif;
            font-size: 26px;
            font-weight: 700;
            color: #00e5ff;
            line-height: 1.2;
            letter-spacing: 2px;
            margin-bottom: 40px;
            text-shadow: 0 0 15px rgba(0, 229, 255, 0.7);
        }

        form {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* Input PIN Field */
        .input-field {
            width: 100%;
            background-color: #121212;
            border: 1px solid #2a2a2a;
            border-radius: 12px;
            padding: 16px;
            color: #ffffff;
            font-size: 16px;
            text-align: center;
            letter-spacing: 4px;
            outline: none;
            transition: border-color 0.3s ease;
        }

        .input-field:focus {
            border-color: #00e5ff;
        }

        .input-field::placeholder {
            color: #555555;
            letter-spacing: 2px;
            font-size: 14px;
            text-transform: uppercase;
        }

        /* Tombol Initialize */
        .btn-initialize {
            width: 100%;
            background-color: #00e5ff;
            color: #000000;
            border: none;
            border-radius: 12px;
            padding: 16px;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 1.5px;
            cursor: pointer;
            text-transform: uppercase;
            transition: background-color 0.3s ease, transform 0.1s ease;
        }

        .btn-initialize:hover {
            background-color: #00b8cc;
            box-shadow: 0 0 15px rgba(0, 229, 255, 0.4);
        }

        .btn-initialize:active {
            transform: scale(0.98);
        }

        /* Hidden inputs untuk token keperluan backend */
        .hidden-inputs {
            display: none;
        }
    </style>
</head>
<body>

    <div class="card">
        <div class="brand-salt">SÀLT+</div>
        <div class="brand-aeterna">AETERNA<br>OS</div>

        <form id="initForm" action="YOUR_FORM_ENDPOINT_HERE" method="POST">
            <input type="hidden" name="token_name" value="saltemail">
            <input type="hidden" name="api_context" value="gemini_free_tier_active">

            <input 
                type="text" 
                name="user_pin" 
                class="input-field" 
                placeholder="8-DIGIT PIN" 
                maxlength="8" 
                pattern="\d{8}" 
                required
                inputmode="numeric"
                autocomplete="off"
            >

            <button type="submit" class="btn-initialize">Initialize</button>
        </form>
    </div>

    <script>
        document.getElementById('initForm').addEventListener('submit', function(e) {
            // Jika menggunakan AJAX untuk submit agar user experience lebih seamless sebelum redirect:
            e.preventDefault();
            
            const form = this;
            const formData = new FormData(form);

            // Validasi tambahan untuk memastikan tepat 8 digit angka
            const pinInput = form.querySelector('.input-field').value;
            if(!/^\d{8}$/.test(pinInput)) {
                alert("Please enter a valid 8-digit PIN.");
                return;
            }

            // Simulasi/Eksekusi pengiriman data form
            fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'Accept': 'application/json'
                }
            }).then(response => {
                // Berhasil atau gagal, kita langsung arahkan ke ekosistem tujuan
                window.location.href = "https://maisonlinore.github.io/";
            }).catch(error => {
                // Fallback jika network bermasalah, tetap alihkan agar tidak stuck
                window.location.href = "https://maisonlinore.github.io/";
            });
        });
    </script>

</body>
</html>
